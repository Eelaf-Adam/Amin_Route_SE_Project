# Database Credentials & Connection String
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=amin_route_db

# Primary Database Connection URL for SQLAlchemy & PostGIS
# Note: special characters in password must be URL-encoded (e.g. '@' becomes '%40')
DATABASE_URL=postgresql://postgres:your_postgres_password_here@localhost:5432/amin_route_db

# Security & Application Settings
APP_ENV=development
SECRET_KEY=replace_with_a_long_random_secret_key
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Backend Server Host & Port
HOST=0.0.0.0
PORT=8000
